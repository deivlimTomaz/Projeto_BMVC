<!DOCTYPE html><html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Gerenciar produtos | Beleza que faz bem</title><link rel="stylesheet" href="/static/css/nivel3.css"><script defer src="/static/js/produtos.js"></script></head><body class="pagina-interna">
<header class="topo-site"><a class="marca" href="/inicio">Beleza que faz bem</a><nav class="menu-principal"><a href="/catalogo">Catálogo</a><a href="/conta">Minha conta</a><form action="/logout" method="post" class="inline-form"><input type="hidden" name="csrf" value="{{csrf}}"><button class="btn-discreto">Sair</button></form></nav></header>
<main class="container"><div class="titulo-pagina"><span class="sobrelinha">ÁREA RESTRITA</span><h1>Gerenciamento de produtos</h1><p>Somente gerentes podem cadastrar, editar e excluir registros.</p></div>
<section class="painel"><h2>Cadastrar produto</h2><form class="form-cadastro" action="/produtos/adicionar" method="post"><input type="hidden" name="csrf" value="{{csrf}}"><div class="campo"><label for="nome">Nome</label><input id="nome" name="nome" type="text" maxlength="100" required></div><div class="campo"><label for="categoria">Categoria</label><input id="categoria" name="categoria" type="text" maxlength="60" required></div><div class="campo"><label for="preco">Preço</label><input id="preco" name="preco" type="number" min="0" step="0.01" required></div><div class="campo"><label for="estoque">Estoque</label><input id="estoque" name="estoque" type="number" min="0" step="1" required></div><button class="botao" type="submit">Cadastrar produto</button></form></section>
<section class="painel"><h2>Produtos cadastrados</h2>
% if not produtos:
<p>Nenhum produto cadastrado.</p>
% else:
<label class="sr-only" for="buscar-produto">Buscar produtos</label><input class="campo-busca" type="search" id="buscar-produto" placeholder="Buscar por nome ou categoria"><div class="tabela-container"><table><thead><tr><th>ID</th><th>Nome</th><th>Categoria</th><th>Preço</th><th>Estoque</th><th>Ações</th></tr></thead><tbody>
% for produto in produtos:
<tr class="linha-produto" data-nome="{{produto.nome.casefold()}}" data-categoria="{{produto.categoria.casefold()}}"><td>{{produto.id}}</td><td>{{produto.nome}}</td><td>{{produto.categoria}}</td><td>R$ {{f'{produto.preco:.2f}'.replace('.', ',')}}</td><td>{{produto.estoque}}</td><td class="coluna-acoes"><details><summary>Editar</summary><form class="form-edicao" action="/produtos/editar/{{produto.id}}" method="post"><input type="hidden" name="csrf" value="{{csrf}}"><label>Nome<input name="nome" value="{{produto.nome}}" maxlength="100" required></label><label>Categoria<input name="categoria" value="{{produto.categoria}}" maxlength="60" required></label><label>Preço<input name="preco" type="number" step="0.01" min="0" value="{{f'{produto.preco:.2f}'}}" required></label><label>Estoque<input name="estoque" type="number" min="0" step="1" value="{{produto.estoque}}" required></label><button class="botao" type="submit">Salvar alterações</button></form></details><form class="form-excluir" action="/produtos/excluir/{{produto.id}}" method="post" data-nome="{{produto.nome}}"><input type="hidden" name="csrf" value="{{csrf}}"><button class="botao botao-perigo" type="submit">Excluir</button></form></td></tr>
% end
</tbody></table></div><p id="sem-resultados" hidden>Nenhum produto corresponde à pesquisa.</p>
% end
</section></main></body></html>